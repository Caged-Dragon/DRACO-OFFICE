{
  "name": "draco-slides",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:desktop": "vite build --mode desktop",
    "desktop:start": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "main": "desktop/main.cjs",
  "description": "Draco Slides presentation editor",
  "author": "Draco Office",
  "build": {
    "appId": "com.dracooffice.slides",
    "productName": "Draco Slides",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Draco-Slides-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "Draco-Slides-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "artifactName": "Draco-Slides-${version}.${ext}"
    }
  }
}
