# Public values only. Never put a service-role/secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# GitHub repo (owner/name) that holds the draco-slides/v* tags. Must be public: no token is ever sent from the browser.
VITE_GITHUB_REPO=OWNER/REPO
